# Copy this file to ".env" and edit. NEVER commit ".env" to GitHub.

ENVIRONMENT=development

# Generate a real key with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-generate-a-long-random-string

# --- Database -------------------------------------------------------------
# Option 1 (default): SQLite file. Zero setup, good for getting started.
DATABASE_URL=sqlite:///./securehelpdesk.db

# Option 2: SQL Server Express (Windows authentication). Create an empty
# database called SecureHelpDesk in SSMS first, then use this instead:
# DATABASE_URL=mssql+pyodbc://@localhost\SQLEXPRESS/SecureHelpDesk?driver=ODBC+Driver+18+for+SQL+Server&trusted_connection=yes&TrustServerCertificate=yes

# Option 3: SQL Server with a SQL login
# DATABASE_URL=mssql+pyodbc://helpdesk_app:YourPassword@localhost:1433/SecureHelpDesk?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes

ACCESS_TOKEN_EXPIRE_MINUTES=30
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
CORS_ORIGINS=["http://localhost:5173"]

# --- Optional: bootstrap an Administrator on first startup ---------------
# Only needed on hosts with no terminal (e.g. Render). Leave blank locally;
# use `python -m scripts.create_admin` instead.
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# ADMIN_BOOTSTRAP_NAME=Admin User
# ADMIN_BOOTSTRAP_PASSWORD=ChangeThisPassw0rd!
